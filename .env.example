# Copy this file to .env and fill in your own values.
# .env is gitignored and will NEVER be committed -- config.py reads
# these at startup and fails with a clear error if any are missing.

# SAP login credentials
SAP_CLIENT=100
SAP_USERNAME=your_sap_username
SAP_PASSWORD=your_sap_password

# SAP Logon's saved connection name, exactly as it appears in the
# SAP Logon connection picker
SAP_CONNECTION=Your SAP Logon Connection Name

# Plant / storage locations used by the MB52-based features (DOI,
# BIB) -- specific to your own SAP landscape
SAP_PLANT=YOUR_PLANT_CODE
SAP_STORAGE=YOUR_STORAGE_LOCATION
SAP_BIB_STORAGE_LOCATION=YOUR_BIB_STORAGE_LOCATION

# Saved ALV layout variant name used when opening MB52
SAP_LAYOUT=/YOUR_LAYOUT_VARIANT
